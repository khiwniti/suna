# ============================================================================
# Carbon BIM — Backend Production Environment
# Copy to: backend/.env
# ============================================================================

# ── Environment ──────────────────────────────────────────────────────────────
ENV_MODE=production

# ── Supabase (REQUIRED) ───────────────────────────────────────────────────────
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# ── Redis (auto-configured via Docker) ───────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_SSL=False

# ── LLM (at least one required) ──────────────────────────────────────────────
ANTHROPIC_API_KEY=YOUR_ANTHROPIC_KEY
OPENAI_API_KEY=                        # optional

# ── Search & Scraping (REQUIRED for agent tools) ─────────────────────────────
TAVILY_API_KEY=YOUR_TAVILY_KEY
FIRECRAWL_API_KEY=YOUR_FIRECRAWL_KEY
RAPID_API_KEY=YOUR_RAPID_API_KEY

# ── Security ──────────────────────────────────────────────────────────────────
MCP_CREDENTIAL_ENCRYPTION_KEY=         # generate: openssl rand -hex 32
KORTIX_ADMIN_API_KEY=                  # generate: openssl rand -hex 32

# ── Billing (optional) ────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ── Observability (optional) ──────────────────────────────────────────────────
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# ── Google OAuth (optional) ───────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://bim.ensim.space/api/google/callback
